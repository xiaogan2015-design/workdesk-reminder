<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource Canvas}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="194"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="Sidebar" Background="#241B3D" Padding="17,26,17,17">
        <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" Margin="6,0,0,33">
                    <Border Width="40" Height="40" CornerRadius="11" Background="#7854EE">
                        <TextBlock Text="&#xE73A;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="工笺" FontWeight="Bold" FontSize="{DynamicResource SectionSize}" Foreground="White" />
                        <TextBlock Text="WORKDESK" FontSize="9" FontWeight="SemiBold" Foreground="#C1B3E4" />
                    </StackPanel>
                </StackPanel>
                <Button x:Name="DeskNav" Style="{StaticResource ActiveNav}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Foreground="White" Margin="0,0,11,0" VerticalAlignment="Center"/><TextBlock Text="工作台" Foreground="White"/></StackPanel></Button>
                <Button x:Name="ArchiveNav" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" Foreground="#D9CFF1" Margin="0,0,11,0" VerticalAlignment="Center"/><TextBlock Text="事项归档" Foreground="#E7DEF7"/></StackPanel></Button>
                <Button x:Name="SummaryNav" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" Foreground="#D9CFF1" Margin="0,0,11,0" VerticalAlignment="Center"/><TextBlock Text="工作总结" Foreground="#E7DEF7"/></StackPanel></Button>
                <Button x:Name="SettingsNav" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="#D9CFF1" Margin="0,0,11,0" VerticalAlignment="Center"/><TextBlock Text="提醒设置" Foreground="#E7DEF7"/></StackPanel></Button>
            </StackPanel>
            <Border DockPanel.Dock="Bottom" Padding="10,10,8,10" CornerRadius="8" Background="#322752">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="#8FE1C2" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="数据保存在本机" Foreground="#E7DEF7" FontSize="{DynamicResource CaptionSize}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DockPanel>
    </Border>

    <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PageContent" Margin="28,23,28,22">
                <DockPanel x:Name="PageHeader" Margin="0,0,0,18">
                    <Border DockPanel.Dock="Right" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="11,6" CornerRadius="8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Violet}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="DateLabel" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="PageTitle" Text="工作台" FontSize="{DynamicResource PageTitleSize}" FontWeight="Bold" VerticalAlignment="Center" />
                </DockPanel>

                <StackPanel x:Name="Dashboard">
                    <Border CornerRadius="15" Margin="0,0,0,14">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.9"><GradientStop Color="#39236F" Offset="0"/><GradientStop Color="#6041BD" Offset="1"/></LinearGradientBrush></Border.Background>
                        <Grid ClipToBounds="True" MinHeight="126">
                            <Rectangle HorizontalAlignment="Right" Margin="0,-56,129,0" RadiusX="26" RadiusY="26" Width="155" Height="164" Stroke="#36E6DDFF" StrokeThickness="1" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False"><Rectangle.RenderTransform><RotateTransform Angle="24"/></Rectangle.RenderTransform></Rectangle>
                            <Rectangle HorizontalAlignment="Right" Margin="0,0,64,-86" RadiusX="26" RadiusY="26" Width="168" Height="161" Stroke="#29E6DDFF" StrokeThickness="1" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False"><Rectangle.RenderTransform><RotateTransform Angle="24"/></Rectangle.RenderTransform></Rectangle>
                            <DockPanel Margin="23,20">
                                <Button x:Name="NewTask" DockPanel.Dock="Right" Content="＋ 新建事项" Foreground="#3E257D" VerticalAlignment="Center" Padding="15,10" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="待办事项" FontSize="{DynamicResource HeroTitleSize}" FontWeight="Bold" Foreground="White" />
                                    <TextBlock x:Name="HeroStatus" Foreground="#EEE5FF" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>
                    <UniformGrid Columns="3" Margin="0,0,0,18">
                        <Button x:Name="PendingShortcut" Style="{StaticResource Metric}" Margin="0,0,8,0" AutomationProperties.Name="查看全部待办">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="→" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="5,0,0,0" />
                                <Border DockPanel.Dock="Left" Background="#EFE9FE" CornerRadius="8" Width="34" Height="34" Margin="0,0,8,0">
                                    <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" Foreground="#6542D5" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="17" />
                                </Border>
                                <StackPanel><TextBlock Text="待处理" Style="{StaticResource Hint}"/><TextBlock x:Name="PendingCount" FontSize="{DynamicResource NumberSize}" FontWeight="Bold" /></StackPanel>
                            </DockPanel>
                        </Button>
                        <Button x:Name="OverdueShortcut" Style="{StaticResource Metric}" Margin="4,0" AutomationProperties.Name="查看已逾期事项">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="→" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="5,0,0,0" />
                                <Border DockPanel.Dock="Left" Background="#FCF0E4" CornerRadius="8" Width="34" Height="34" Margin="0,0,8,0">
                                    <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="#9C4D11" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="17" />
                                </Border>
                                <StackPanel><TextBlock Text="已逾期" Style="{StaticResource Hint}"/><TextBlock x:Name="OverdueCount" FontSize="{DynamicResource NumberSize}" FontWeight="Bold" /></StackPanel>
                            </DockPanel>
                        </Button>
                        <Button x:Name="CompletedShortcut" Style="{StaticResource Metric}" Margin="8,0,0,0" AutomationProperties.Name="查看已完成事项">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="→" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="5,0,0,0" />
                                <Border DockPanel.Dock="Left" Background="#E4F6EF" CornerRadius="8" Width="34" Height="34" Margin="0,0,8,0">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="#13745A" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="17" />
                                </Border>
                                <StackPanel><TextBlock Text="今日完成" Style="{StaticResource Hint}"/><TextBlock x:Name="CompletedCount" FontSize="{DynamicResource NumberSize}" FontWeight="Bold" /></StackPanel>
                            </DockPanel>
                        </Button>
                    </UniformGrid>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2.18*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*" MinWidth="197" MaxWidth="360"/></Grid.ColumnDefinitions>
                        <Border x:Name="TaskCard" Style="{StaticResource Card}" Padding="17,16" MinHeight="221" VerticalAlignment="Top">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="CopyPlan" Content="复制清单" Padding="9,5" Margin="0,0,6,0" ToolTip="复制全部事项（含已归档）为 Markdown" />
                                        <Button x:Name="ExportPlan" Content="导出清单" Padding="9,5" ToolTip="将全部事项导出为 Markdown 文件" />
                                    </StackPanel>
                                    <TextBlock Text="事项清单" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                                <WrapPanel x:Name="Filters" Margin="0,0,0,11" />
                                <ScrollViewer x:Name="TaskListScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="395" Focusable="False">
                                    <StackPanel x:Name="TaskRows" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="RightColumn" Grid.Column="2">
                            <Border Style="{StaticResource Card}" Background="#F0EBFC" BorderBrush="#E9DFFB" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="工作总结" FontSize="{DynamicResource SectionSize}" FontWeight="Bold" />
                                    <TextBlock x:Name="SummaryStatus" Style="{StaticResource Hint}" Margin="0,5,0,10" />
                                    <Button x:Name="TodaySummary" Style="{StaticResource Quiet}" Background="White" HorizontalAlignment="Left" Content="写今日日报  →" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="总结提醒" FontSize="{DynamicResource SectionSize}" FontWeight="Bold" />
                                    <TextBlock x:Name="ScheduleStatus" Style="{StaticResource Hint}" Margin="0,5,0,10" />
                                    <Button x:Name="OpenSettings" HorizontalAlignment="Left" Content="提醒设置  →" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <ContentControl x:Name="OtherPage" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
        <Border x:Name="Banner" Grid.Row="1" Visibility="Collapsed" Background="#EDE8FD" Padding="14,8">
            <TextBlock x:Name="BannerMessage" Foreground="#412E76" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Grid>
